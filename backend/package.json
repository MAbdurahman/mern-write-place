{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend for mern-write-place application",
  "main": "/src/server.js",
  "repository": "https://github.com/MAbdurahman/mern-write-place.git",
  "author": "Mahdi Abdurrahman",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "cross-env NODE_ENV=development& nodemon server.js",
    "client": "npm start --prefix ../frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prod": "cross-env NODE_ENV=production& node server.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "@exortek/express-mongo-sanitize": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.9.0",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "nodemailer": "10.0.13",
    "validator": "^13.15.26"
  },
  "nodemonConfig": {
    "delay": 2000
  }
}